#!/bin/sh
# Fast, portable AppRun for ready2rip AppImage.
# Prefer bundled Python + GI stack so GitHub downloads work without matching host deps.

HERE="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
export APPDIR="$HERE"

# Bundled tools first (cdparanoia, flac, ffmpeg, …)
export PATH="$HERE/usr/bin${PATH:+:$PATH}"

# ---------------------------------------------------------------------------
# Python: require AppImage-bundled interpreter (stdlib is also bundled).
# Do not fall back to host python — ABI-specific gi modules will not load.
# ---------------------------------------------------------------------------
PYTHON=""
for cand in \
  "$HERE/usr/bin/python3" \
  "$HERE/usr/bin/python3.14" \
  "$HERE/usr/bin/python3.13" \
  "$HERE/usr/bin/python3.12" \
  "$HERE/usr/bin/python3.11"
do
  if [ -x "$cand" ]; then
    PYTHON="$cand"
    break
  fi
done
if [ -z "$PYTHON" ]; then
  echo "ready2rip: bundled python3 not found (AppImage incomplete or broken)" >&2
  exit 1
fi

# Point at bundled stdlib under usr/lib/pythonX.Y (prefix layout).
export PYTHONHOME="$HERE/usr"
# Avoid user site-packages leaking host packages into the app.
export PYTHONNOUSERSITE=1

# ---------------------------------------------------------------------------
# Module path: app package + mutagen + bundled PyGObject
# ---------------------------------------------------------------------------
export PYTHONPATH="$HERE/usr/share/ready2rip"
if [ -d "$HERE/usr/lib/python3/site-packages" ]; then
  export PYTHONPATH="$HERE/usr/lib/python3/site-packages:$PYTHONPATH"
fi
# Versioned site-packages (e.g. python3.14/site-packages)
for d in "$HERE/usr/lib"/python3.*/site-packages; do
  [ -d "$d" ] || continue
  export PYTHONPATH="$d:$PYTHONPATH"
done

# ---------------------------------------------------------------------------
# GSettings + XDG data
# ---------------------------------------------------------------------------
export GSETTINGS_SCHEMA_DIR="$HERE/usr/share/glib-2.0/schemas"
export XDG_DATA_DIRS="$HERE/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

# ---------------------------------------------------------------------------
# Shared libraries + GObject Introspection typelibs
# Bundled libs first; host still searched after (Mesa, Vulkan, libGL, …).
# ---------------------------------------------------------------------------
if [ -d "$HERE/usr/lib" ]; then
  export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
if [ -d "$HERE/usr/lib64" ]; then
  export LD_LIBRARY_PATH="$HERE/usr/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
# Multiarch / hwcaps fallbacks inside AppDir
for d in \
  "$HERE/usr/lib"/x86_64-linux-gnu \
  "$HERE/usr/lib"/aarch64-linux-gnu \
  "$HERE/usr/lib"/glibc-hwcaps/x86-64-v3 \
  "$HERE/usr/lib"/glibc-hwcaps/x86-64-v2
do
  [ -d "$d" ] || continue
  export LD_LIBRARY_PATH="$d${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
done

if [ -d "$HERE/usr/lib/girepository-1.0" ]; then
  export GI_TYPELIB_PATH="$HERE/usr/lib/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
fi
if [ -d "$HERE/usr/lib64/girepository-1.0" ]; then
  export GI_TYPELIB_PATH="$HERE/usr/lib64/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
fi

# GdkPixbuf loaders when bundled (generated loaders.cache paths are relative-safe via env)
if [ -d "$HERE/usr/lib/gdk-pixbuf-2.0" ]; then
  # Prefer any loaders.cache we shipped
  for cache in "$HERE/usr/lib"/gdk-pixbuf-2.0/*/loaders.cache; do
    if [ -f "$cache" ]; then
      export GDK_PIXBUF_MODULE_FILE="$cache"
      break
    fi
  done
fi

# GStreamer: prefer bundled CDDA/audio plugins; fall back to host for sinks.
if [ -d "$HERE/usr/lib/gstreamer-1.0" ]; then
  GST_PLUGIN_PATH="$HERE/usr/lib/gstreamer-1.0"
  for d in \
    /usr/lib64/gstreamer-1.0 \
    /usr/lib/x86_64-linux-gnu/gstreamer-1.0 \
    /usr/lib/gstreamer-1.0
  do
    [ -d "$d" ] || continue
    GST_PLUGIN_PATH="$GST_PLUGIN_PATH:$d"
  done
  export GST_PLUGIN_PATH
  # Keep scanner registry inside a writable user dir (AppImage root is read-only).
  export GST_REGISTRY="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/ready2rip/gstreamer-registry.bin"
  mkdir -p "$(dirname "$GST_REGISTRY")" 2>/dev/null || true
  if [ -x "$HERE/usr/libexec/gstreamer-1.0/gst-plugin-scanner" ]; then
    export GST_PLUGIN_SCANNER="$HERE/usr/libexec/gstreamer-1.0/gst-plugin-scanner"
  fi
fi

# -B: do not write .pyc into a read-only AppImage mount
exec "$PYTHON" -B -m ready2rip.main "$@"
