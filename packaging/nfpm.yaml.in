# Generated by packaging/build-deb-rpm.sh — do not edit by hand.
name: ready2rip
arch: ${NFPM_ARCH}
platform: linux
version: ${VERSION}
release: "1"
section: sound
priority: optional
maintainer: gnostiko <https://github.com/gnostiko/ready2rip>
description: |
  Secure CD ripper for Linux.
  Full cdparanoia extraction with AccurateRip and CTDB verification,
  MusicBrainz metadata, and modern tagging (GTK 4 / libadwaita).
vendor: gnostiko
homepage: https://github.com/gnostiko/ready2rip
license: GPL-3.0-or-later
contents:
  - src: ${STAGE}/usr
    dst: /usr
    type: tree
scripts:
  postinstall: ${ROOT}/packaging/postinst.sh
  postremove: ${ROOT}/packaging/postrm.sh
overrides:
  deb:
    depends:
      - python3
      - python3-gi
      - gir1.2-gtk-4.0
      - gir1.2-adw-1
      - python3-mutagen
      - python3-pil
      - cdparanoia
      - flac
      - lame
      - ffmpeg
      - opus-tools
  rpm:
    depends:
      - python3
      - python3-gobject
      - gtk4
      - libadwaita
      - python3-mutagen
      - python3-pillow
      - cdparanoia
      - flac
      - lame
      - ffmpeg
      - opus-tools
