<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APPLICATION_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>ready2rip</name>
  <summary>Secure CD ripper for Linux</summary>
  <icon type="stock">@APPLICATION_ID@</icon>
  <description>
    <p>
      Ready2Rip is a secure CD ripper for Linux. Built as a modern GNOME app, it
      focuses on careful archival extraction with full cdparanoia (test &amp;
      copy, retries, and drive calibration), then verifies results with
      AccurateRip.
    </p>
    <p>
      It also looks up metadata via MusicBrainz (and FreeDB-compatible services),
      writes ReplayGain, and fetches album art with optional embed sizes—so you
      get trustworthy rips and complete tags in one place.
    </p>
  </description>
  <launchable type="desktop-id">@APPLICATION_ID@.desktop</launchable>
  <url type="homepage">@PACKAGE_URL@</url>
  <url type="bugtracker">@BUGTRACKER_URL@</url>
  <developer id="io.github.gnostiko">
    <name>gnostiko</name>
  </developer>
  <releases>
    <release version="@APPLICATION_VERSION@" date="2026-08-11">
      <description>
        <p>
          0.4.0: Secure-CD-ripper-for-Linux positioning; System/Light/Dark
          appearance with pure-black dark and warm-grey light chrome; Art + Album
          side-by-side layout with cover origin/size captions; nested embed under
          Download artwork; Calibrate drive in Ripping; UI refactor
          (window.ui, theme module).
        </p>
      </description>
    </release>
    <release version="0.3.0" date="2026-08-01">
      <description>
        <p>
          MusicBrainz release-link lookup when auto-match is wrong;
          smarter burst fallback (one CRC retry, then full-disc burst re-rip);
          archival rip log with accurate CRC/mode/session history; Lookup menu;
          pill Eject/Rip styling; bottom progress panel polish.
        </p>
      </description>
    </release>
    <release version="0.2.0" date="2026-07-21">
      <description>
        <p>
          Secure cdparanoia extraction with test &amp; copy, AccurateRip,
          CUE/log output, Copy Image mode, AppImage packaging with Gear Lever
          update support, and UI polish.
        </p>
      </description>
    </release>
  </releases>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
</component>
